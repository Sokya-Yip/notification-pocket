<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/support_wechat_title"
            android:textColor="@color/forest"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/support_voluntary"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/support_wechat_qr"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/white"
            android:contentDescription="@string/support_qr_description"
            android:scaleType="fitCenter"
            android:src="@drawable/support_wechat_qr" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/support_scan_hint"
            android:textColor="@color/secondary_ink"
            android:textSize="13sp" />

        <Button
            style="@style/Widget.NotificationPocket.Button.Tonal"
            android:id="@+id/share_support_wechat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/support_share_wechat" />
    </LinearLayout>
</ScrollView>
